{
	"name": "letterboxd-recent-films",
	"version": "1.0.1",
	"description": "Show a Letterboxd user's latest diary entries as movie posters in Obsidian notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"build": "npm run typecheck && node esbuild.config.mjs production && node scripts/verify-release.mjs",
		"check": "npm run typecheck && npm run lint && npm test && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"letterboxd",
		"movies",
		"rss"
	],
	"author": "Jasper",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jasperdevs/letterboxd-recent-films.git"
	},
	"bugs": {
		"url": "https://github.com/jasperdevs/letterboxd-recent-films/issues"
	},
	"homepage": "https://github.com/jasperdevs/letterboxd-recent-films#readme",
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^26.1.0",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6"
	}
}
